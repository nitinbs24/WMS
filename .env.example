# --- Database ---
DATABASE_URL=postgresql+asyncpg://warehaven:warehaven@db:5432/warehaven

# --- Redis / arq ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# --- File Storage ---
# Local volume path for layout imports (dev).
# Becomes an S3 bucket key prefix in the production phase.
LAYOUT_STORAGE_PATH=/data/layout-imports

# --- App ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# --- Seed Admin User (created on first startup) ---
SEED_ADMIN_EMAIL=admin@warehaven.local
SEED_ADMIN_PASSWORD=change-me
